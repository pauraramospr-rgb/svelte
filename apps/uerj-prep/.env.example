# Chave da API da Anthropic (obrigatória para os recursos de IA: tutor, correções e questões inéditas).
ANTHROPIC_API_KEY=
# Modelo usado pela plataforma (padrão: claude-opus-5-5).
ANTHROPIC_MODEL=claude-opus-5-5
# Caminho do banco SQLite (padrão: ./data/app.db).
DATABASE_PATH=./data/app.db
# Necessário em produção atrás de proxy (ver documentação do adapter-node).
ORIGIN=http://localhost:3000
